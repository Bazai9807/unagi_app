# Copy to .env and generate a random 64-hex-character encryption key. Never commit .env.
# For local development use npm run setup to generate config and passwords automatically.
ENCRYPTION_KEY=
NODE_ENV=development
HOST=127.0.0.1
PORT=4300
PUBLIC_ORIGIN=http://127.0.0.1:4300
# On production use PostgreSQL, HTTPS reverse proxy, and a restricted database role.
DATABASE_URL=
SMSRU_API_KEY=
ENABLE_EMAIL=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
ENABLE_LIVE_PAYMENTS=false
